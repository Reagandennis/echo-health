# Echo Health — environment template.
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Anything not prefixed NEXT_PUBLIC_ is server-only and must stay secret.

# ─── Database ────────────────────────────────────────────────────────────────
# Application connection: a role that is SUBJECT to Row-Level Security.
# Azure Postgres rejects unencrypted connections, so sslmode=require is required.
# ── Database ──────────────────────────────────────────────────────────────
#
# TWO ROLES, AND POINTING THE APP AT THE WRONG ONE DISABLES ALL SECURITY.
#
#   APP_DATABASE_URL  role `echo_app`   — the application. Subject to RLS.
#   DATABASE_URL      role `echo_admin` — migrations only. HAS BYPASSRLS.
#
# `echo_admin` bypasses every row-level security policy in migration 0001, so
# an app connected as it returns every row to every user and nothing in the UI
# looks different. See docker/postgres/init/01-roles.sql.
#
# The values below are the local Docker stack (`docker compose up -d`, then
# `npm run db:setup`). Azure needs `?sslmode=require` — only an explicit
# `sslmode=disable` turns TLS off, so a production URL that omits the parameter
# still gets encrypted.
APP_DATABASE_URL=postgres://echo_app:echo_app_local@127.0.0.1:5432/echo?sslmode=disable
# Admin connection: used ONLY by drizzle-kit migrations. It bypasses RLS —
# never point the running app at this.
DATABASE_URL=postgres://echo_admin:echo_admin_local@127.0.0.1:5432/echo?sslmode=disable

# ─── Redis (OPTIONAL) ────────────────────────────────────────────────────────
# Shared store for rate limiting (lib/rate-limit.ts). Leaving this UNSET is a
# fully supported state, not a degraded one: the limiter falls back to an
# in-memory token bucket and the app behaves identically. Set it to make the
# limits hold ACROSS instances — without it, N app instances mean N× the limit.
# The limiter also fails open, so a Redis blip degrades to per-instance rather
# than 429-ing payments or the support chat.
# REDIS_URL=redis://localhost:6379

# ─── Authentication (Supabase Auth) ──────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
#
# The first two are safe in the browser: the anon key identifies the project
# and carries no privilege of its own — every authority decision is made by
# row-level security against the caller's JWT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# ⚠️  SERVER ONLY. BYPASSES ROW-LEVEL SECURITY ENTIRELY.
#
# The Supabase equivalent of connecting as `echo_admin`. Needed for exactly one
# job: writing `app_metadata.roles`, which is where roles live and which a user
# must not be able to write for themselves. Never prefix this NEXT_PUBLIC_,
# never import it into a client component, and never reach for it to clear a
# permission error — the error means a policy is wrong.
SUPABASE_SERVICE_ROLE_KEY=

# App origin. Must be in the Supabase dashboard's redirect allowlist
# (Authentication → URL Configuration) as <origin>/auth/callback, or OAuth and
# the email links come back to nowhere.
APP_BASE_URL=http://localhost:3000

# Bootstrap roles by VERIFIED email, comma-separated. Solves the chicken-and-egg
# of granting the first admin on a fresh project — you cannot reach /admin to
# administer anything until someone is already an admin. Unset these once real
# roles are assigned: an env var that grants admin is not something to leave in
# a production environment.
# ADMIN_EMAILS=
# THERAPIST_EMAILS=
# CLIENT_EMAILS=

# ─── Video (Echo video backend) ──────────────────────────────────────────────
ECHO_VIDEO_API_URL=https://video.echopsychology.com
# Tenant API key (sk_live_…). Server-only — it can mint sessions; never expose it.
ECHO_VIDEO_API_KEY=

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
# Secret key (sk_…) — can charge cards and issue refunds. Server-only.
PAYSTACK_SECRET_KEY=

# ── Regional pricing: do you trust your edge's country header? ────────────
#
# `lib/pricing.ts` charges some countries a lower KES amount, chosen from the
# `CF-IPCountry` (or `x-vercel-ip-country`) header. That header is worth exactly
# as much as the guarantee that requests cannot reach the app without passing
# through the edge that sets it.
#
#   SET IT TO "true" ONLY where that holds — e.g. the Cloudflare Tunnel in
#   `cloudflared/config.yml`, which is outbound-only and opens no inbound port,
#   and where Cloudflare overwrites any CF-* header a client sends.
#
#   LEAVE IT UNSET anywhere the origin can be reached directly: a local dev
#   server, a raw Azure App Service hostname, a preview deployment. There,
#   `curl -H 'cf-ipcountry: UG'` would be a ~45% discount and nothing in a log
#   could tell that request from a real one.
#
# Unset means every customer is charged the standard published price. That is
# the safe failure: bands only ever reduce a price, so the worst a liar can
# achieve is paying full price. Exact string "true", like DEV_AUTH_ENABLED.
# TRUST_EDGE_COUNTRY_HEADER=true

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Optional in development — email features no-op gracefully when unset.
RESEND_API_KEY=
# Must be on a domain VERIFIED in your Resend account. A placeholder domain
# is refused with a 403, and KYC mail swallows transport errors — so the send
# fails silently while every guard in lib/email.ts reports healthy.
SMTP_SENDER_EMAIL=noreply@your-verified-domain.com
# Display name on outgoing mail. Defaults to "Echo Health" when unset.
SMTP_SENDER_NAME="Echo Health"

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Either name works. PostHog\'s dashboard labels this a "Project API key",
# so it often lands in a variable named after the label rather than the
# docs — and a mismatch disables analytics silently.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=  (alias, same value)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Site ────────────────────────────────────────────────────────────────────
# Public origin for OAuth redirect URLs in SSR contexts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Bootstrap role escape-hatch (leave UNSET in production) ──────────────────
# Comma-separated VERIFIED emails granted a role before their first login.
# Exists to solve the first-admin chicken-and-egg; unset once roles are assigned.
# ADMIN_EMAILS=
# THERAPIST_EMAILS=
# CLIENT_EMAILS=

# ── Local sign-in without Auth0 (development only) ────────────────────────
#
# Enables /dev-login, which mints a synthetic session for an admin, therapist
# or client persona. There are no test accounts in the database to hand out:
# authentication is Auth0 Universal Login, so the app never sees a password
# and accounts live in the Auth0 tenant.
#
# CANNOT take effect in a production build. lib/auth/dev-session.ts also
# requires NODE_ENV !== "production", which Next inlines, so the code is
# dropped from the bundle — /dev-login returns 404 there even with this set.
#
# UNSET BEFORE EXPOSING A DEV SERVER OVER A TUNNEL. That is the one case the
# build-time guard cannot rule out.
# DEV_AUTH_ENABLED=true
