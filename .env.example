# Echo Health — environment template.
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Anything not prefixed NEXT_PUBLIC_ is server-only and must stay secret.

# ─── Database ────────────────────────────────────────────────────────────────
# Application connection: a role that is SUBJECT to Row-Level Security.
# Azure Postgres rejects unencrypted connections, so sslmode=require is required.
APP_DATABASE_URL=postgres://echo_app:CHANGE_ME@localhost:5432/echo?sslmode=require
# Admin connection: used ONLY by drizzle-kit migrations. It bypasses RLS —
# never point the running app at this.
DATABASE_URL=postgres://echo_admin:CHANGE_ME@localhost:5432/echo?sslmode=require

# ─── Auth0 (Universal Login) ─────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex used to encrypt the session cookie. Generate: openssl rand -hex 32
AUTH0_SECRET=
# App origin. Must match an Auth0 "Allowed Callback URL" (<origin>/auth/callback).
APP_BASE_URL=http://localhost:3000
# Auth0 Management API (machine-to-machine) — for programmatic role assignment.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ─── Video (Echo video backend) ──────────────────────────────────────────────
ECHO_VIDEO_API_URL=https://video.echopsychology.com
# Tenant API key (sk_live_…). Server-only — it can mint sessions; never expose it.
ECHO_VIDEO_API_KEY=

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
# Secret key (sk_…) — can charge cards and issue refunds. Server-only.
PAYSTACK_SECRET_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Optional in development — email features no-op gracefully when unset.
RESEND_API_KEY=
SMTP_SENDER_EMAIL=noreply@example.com

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Site ────────────────────────────────────────────────────────────────────
# Public origin for OAuth redirect URLs in SSR contexts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Bootstrap role escape-hatch (leave UNSET in production) ──────────────────
# Comma-separated VERIFIED emails granted a role before their first login.
# Exists to solve the first-admin chicken-and-egg; unset once roles are assigned.
# ADMIN_EMAILS=
# THERAPIST_EMAILS=
# CLIENT_EMAILS=
