{
  "name": "echo-health",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=6144' next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate:auto": "drizzle-kit generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:apply": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed-dev.mjs",
    "db:psql": "docker exec -it echo-postgres psql -U echo_admin -d echo",
    "redis:cli": "docker exec -it echo-redis redis-cli",
    "db:setup": "npm run db:up && node scripts/db-wait.mjs && npm run db:apply"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.9.0",
    "next": "^16.2.6",
    "postgres": "^3.4.9",
    "posthog-js": "^1.373.4",
    "posthog-node": "^5.34.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
